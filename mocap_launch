#!/usr/bin/env bash
set -eo pipefail

source /opt/ros/humble/setup.bash
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
VRPN_SERVER="10.1.1.198"
VRPN_PORT="3883"

ros2 launch vrpn_mocap client.launch.yaml \
  server:="$VRPN_SERVER" \
  port:="$VRPN_PORT" \
  frame_id:=map \
  update_freq:=100.0 \
  use_vrpn_timestamps:=false &
vrpn_pid=$!

cleanup() {
  kill "$vrpn_pid" 2>/dev/null || true
  wait "$vrpn_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

python3 "$SCRIPT_DIR/mocap_vision_bridge.py" \
  --ros-args --params-file "$SCRIPT_DIR/mocap_config.yaml"
